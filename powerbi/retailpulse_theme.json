{
  "name": "RetailPulse Supreme Executive - Auto Titles & Extra Large Fonts",
  "dataColors": [
    "#2563EB",
    "#06B6D4",
    "#8B5CF6",
    "#F59E0B",
    "#10B981",
    "#EC4899",
    "#64748B",
    "#0EA5E9",
    "#F97316",
    "#14B8A6",
    "#475569",
    "#3B82F6"
  ],
  "background": "#FFFFFF",
  "foreground": "#0F172A",
  "tableAccent": "#2563EB",
  "good": "#10B981",
  "neutral": "#F59E0B",
  "bad": "#EF4444",
  "maximum": "#1D4ED8",
  "center": "#60A5FA",
  "minimum": "#EFF6FF",
  "visualStyles": {
    "page": {
      "*": {
        "background": [
          {
            "color": { "solid": { "color": "#F1F5F9" } },
            "transparency": 0
          }
        ]
      }
    },
    "*": {
      "*": {
        "background": [
          {
            "show": true,
            "color": { "solid": { "color": "#FFFFFF" } },
            "transparency": 0
          }
        ],
        "border": [
          {
            "show": true,
            "color": { "solid": { "color": "#CBD5E1" } },
            "radius": 12
          }
        ],
        "dropShadow": [
          {
            "show": true,
            "color": { "solid": { "color": "#64748B" } },
            "position": "Outer",
            "preset": "BottomRight",
            "transparency": 88,
            "blur": 8
          }
        ],
        "title": [
          {
            "show": true,
            "fontColor": { "solid": { "color": "#0F172A" } },
            "fontSize": 16,
            "fontFamily": "Segoe UI Bold"
          }
        ]
      }
    },
    "clusteredBarChart": {
      "*": {
        "title": [
          {
            "show": true,
            "text": "Revenue Contribution by Product Category",
            "fontColor": { "solid": { "color": "#0F172A" } },
            "fontSize": 16,
            "fontFamily": "Segoe UI Bold"
          }
        ]
      }
    },
    "lineClusteredColumnComboChart": {
      "*": {
        "title": [
          {
            "show": true,
            "text": "Monthly Revenue Trajectory & MoM Growth Momentum",
            "fontColor": { "solid": { "color": "#0F172A" } },
            "fontSize": 16,
            "fontFamily": "Segoe UI Bold"
          }
        ]
      }
    },
    "donutChart": {
      "*": {
        "title": [
          {
            "show": true,
            "text": "Customer Behavioral Segments (RFM Revenue Share)",
            "fontColor": { "solid": { "color": "#0F172A" } },
            "fontSize": 16,
            "fontFamily": "Segoe UI Bold"
          }
        ]
      }
    },
    "map": {
      "*": {
        "title": [
          {
            "show": true,
            "text": "Geographic Fulfillment Volume & Revenue Density",
            "fontColor": { "solid": { "color": "#0F172A" } },
            "fontSize": 16,
            "fontFamily": "Segoe UI Bold"
          }
        ]
      }
    },
    "card": {
      "*": {
        "background": [
          {
            "show": true,
            "color": { "solid": { "color": "#FFFFFF" } },
            "transparency": 0
          }
        ],
        "border": [
          {
            "show": true,
            "color": { "solid": { "color": "#CBD5E1" } },
            "radius": 10
          }
        ],
        "labels": [
          {
            "color": { "solid": { "color": "#0F172A" } },
            "fontSize": 32,
            "fontFamily": "Segoe UI Bold"
          }
        ],
        "categoryLabels": [
          {
            "show": true,
            "color": { "solid": { "color": "#64748B" } },
            "fontSize": 13,
            "fontFamily": "Segoe UI Bold"
          }
        ]
      }
    },
    "slicer": {
      "*": {
        "background": [
          {
            "show": true,
            "color": { "solid": { "color": "#F8FAFC" } },
            "transparency": 0
          }
        ],
        "border": [
          {
            "show": true,
            "color": { "solid": { "color": "#CBD5E1" } },
            "radius": 8
          }
        ],
        "header": [
          {
            "show": true,
            "fontColor": { "solid": { "color": "#2563EB" } },
            "fontSize": 13,
            "fontFamily": "Segoe UI Bold"
          }
        ],
        "items": [
          {
            "fontColor": { "solid": { "color": "#0F172A" } },
            "background": { "solid": { "color": "#FFFFFF" } },
            "fontFamily": "Segoe UI Semibold",
            "fontSize": 12
          }
        ]
      }
    },
    "textbox": {
      "*": {
        "background": [
          {
            "show": true,
            "color": { "solid": { "color": "#EFF6FF" } },
            "transparency": 0
          }
        ],
        "border": [
          {
            "show": true,
            "color": { "solid": { "color": "#3B82F6" } },
            "radius": 12
          }
        ]
      }
    },
    "tableEx": {
      "*": {
        "grid": [
          {
            "gridVertical": true,
            "gridVerticalColor": { "solid": { "color": "#E2E8F0" } },
            "gridHorizontal": true,
            "gridHorizontalColor": { "solid": { "color": "#E2E8F0" } }
          }
        ],
        "columnHeaders": [
          {
            "fontColor": { "solid": { "color": "#0F172A" } },
            "backColor": { "solid": { "color": "#F1F5F9" } },
            "fontFamily": "Segoe UI Bold",
            "fontSize": 13
          }
        ],
        "values": [
          {
            "fontFamily": "Segoe UI",
            "fontSize": 13,
            "fontColorPrimary": { "solid": { "color": "#0F172A" } },
            "backColorPrimary": { "solid": { "color": "#FFFFFF" } },
            "backColorSecondary": { "solid": { "color": "#F8FAFC" } }
          }
        ]
      }
    },
    "pivotTable": {
      "*": {
        "columnHeaders": [
          {
            "fontColor": { "solid": { "color": "#0F172A" } },
            "backColor": { "solid": { "color": "#F1F5F9" } },
            "fontFamily": "Segoe UI Bold",
            "fontSize": 13
          }
        ],
        "rowHeaders": [
          {
            "fontColor": { "solid": { "color": "#0F172A" } },
            "backColor": { "solid": { "color": "#F8FAFC" } },
            "fontFamily": "Segoe UI Bold",
            "fontSize": 13
          }
        ]
      }
    }
  }
}
